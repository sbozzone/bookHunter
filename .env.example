# ---------------------------------------------------------------------------
# Book Hunter environment configuration
# Copy this file to `.env` and fill in values as needed. All keys are OPTIONAL —
# the app runs without any of them, but features degrade as noted below.
# ---------------------------------------------------------------------------

# Google Books API key — powers fast book search.
# Without a key, search uses the shared *keyless* Google Books quota, which is
# frequently exhausted; the app then falls back to the OpenLibrary API
# (no key, weaker descriptions/covers). Add a key for fast, reliable results.
#   1. https://console.cloud.google.com  →  enable the "Books API"
#   2. Create credentials → API key
#   3. Paste it below (and set the same var in your Vercel project settings).
GOOGLE_BOOKS_API_KEY=

# Anthropic API key — powers the optional "suggest similar books" AI recommender.
# The book SEARCH path does not use this; only the recommender widget does.
# Without it, search works normally and the recommender simply returns an error.
ANTHROPIC_API_KEY=
